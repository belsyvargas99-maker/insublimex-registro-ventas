# ─── INSUBLIMEX · Registro de Ventas ───
# Copia este archivo como .env y completa los valores.

# Clave con la que entran las asesoras al panel (mínimo 8 caracteres; usa una frase).
ADMIN_PIN=cambia-esta-clave
# Secreto para firmar sesiones (cualquier texto largo aleatorio). Si cambia, todas cierran sesión.
SESSION_SECRET=

# ID de la hoja de Google (está en la URL: docs.google.com/spreadsheets/d/AQUÍ_VA_EL_ID/edit)
SHEETS_SPREADSHEET_ID=
# Nombre de la pestaña dentro de la hoja (se crea sola si no existe)
SHEETS_TAB_NAME=Ventas

# Dónde se guardan las fotos de comprobantes: local (en el servidor, recomendado) o drive.
# "drive" SOLO funciona con Google Workspace (unidad compartida); con Gmail Google lo rechaza
# ("Service Accounts do not have storage quota").
RECEIPT_STORAGE=local
# ID de la carpeta de Drive (solo si RECEIPT_STORAGE=drive)
DRIVE_FOLDER_ID=

# Credenciales de la cuenta de servicio de Google. Opción A: dejar el archivo
# service-account.json junto a este .env (recomendado). Opción B: pegar aquí el JSON en base64.
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Asesoras que aparecen en el formulario, separadas por coma (no van en el código)
ASESORAS=Nombre Uno,Nombre Dos

# URL pública de la app (para enlaces en los comprobantes mientras suben a Drive)
PUBLIC_URL=https://ventas.insublimexvnzla.com

PORT=3000
NODE_ENV=production
